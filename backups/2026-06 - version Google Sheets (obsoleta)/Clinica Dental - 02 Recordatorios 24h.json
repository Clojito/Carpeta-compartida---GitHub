    {
      "parameters": {
        "jsCode": "const TIME_ZONE = 'Europe/Lisbon';\nconst parts = new Intl.DateTimeFormat('en-US', {\n  timeZone: TIME_ZONE,\n  year: 'numeric',\n  month: '2-digit',\n  day: '2-digit'\n}).formatToParts(new Date(Date.now() + 24 * 60 * 60 * 1000));\nconst get = type => parts.find(p => p.type === type).value;\nconst mananaStr = get('year') + '-' + get('month') + '-' + get('day');\n\nreturn $input.all()\n  .map(item => item.json || {})\n  .filter(row => {\n    const fecha = row.fecha || '';\n    const estado = (row.estado || '').toLowerCase().trim();\n    const rec = (row.recordatorio_24h || '').toLowerCase().trim();\n    const telefono = (row['Numero de telefono'] || '').toString().trim();\n    return fecha === mananaStr && estado === 'confirmada' && rec === 'no' && telefono !== '' && row['Event ID'];\n  })\n  .map(row => ({\n    json: {\n      ...row,\n      eventId: row['Event ID'],\n      telefono: row['Numero de telefono'].toString(),\n      respuesta: 'Hola ' + row.nombre + ', te recordamos que tienes una cita de ' + row.tratamiento + ' manana a las ' + row.hora + '. Si no puedes asistir, puedes cancelar o cambiar la cita.'\n    }\n  }));\n"
      },
